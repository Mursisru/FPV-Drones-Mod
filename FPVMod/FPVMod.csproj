<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>FPVMod</RootNamespace>
    <AssemblyName>FPVMod</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\fpvmod_assets" Condition="Exists('Resources\fpvmod_assets')" />
    <EmbeddedResource Include="Resources\fpv_shaders.bundle" Condition="Exists('Resources\fpv_shaders.bundle')">
      <LogicalName>FPVMod.Shaders.fpv_shaders.bundle</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\fpv_unit_icon.png" Condition="Exists('Resources\fpv_unit_icon.png')">
      <LogicalName>FPVMod.Resources.fpv_unit_icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
